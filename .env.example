# =============================================================================
# Example Runtime Environment Configuration (NO SECRETS HARDCODED)
# All sensitive values are retrieved dynamically at runtime from
# Google Cloud Secret Manager (`travel_concierge/secret_manager.py`).
# =============================================================================
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Strategic Model Routing IDs (override locally in .env if needed)
FAST_MODEL_ID=gemini-2.5-flash
PRO_PLANNING_MODEL_ID=gemini-2.5-pro

# Set AGENTOPS_OFFLINE_MODE=0 in production so Secret Manager & Cloud DLP APIs are called directly
AGENTOPS_OFFLINE_MODE=0
ENABLE_CLOUD_DLP_API=1
